{
	"name": "tiny-rabbit-discord",
	"version": "2.3.4",
	"description": "A modular Discord bot with core functionality for community management and engagement.",
	"scripts": {
		"dev": "bun --watch src/server.ts",
		"start": "bun src/server.ts",
		"deploy": "bun run build && bun run delete && pm2 start dist/server.js --name discord --log-date-format 'DD-MM' --interpreter ~/.bun/bin/bun",
		"build": "bun run src/utils/build.ts",
		"cloc": "bun run src/utils/cloc.ts",
		"add-commands": "bun run src/deploy-commands.ts",
		"stop": "pm2 stop discord",
		"delete": "pm2 delete discord",
		"restart": "pm2 restart discord --time",
		"db:generate": "bunx drizzle-kit generate",
		"db:migrate": "bun src/db/migrate.ts",
		"db:studio": "bunx drizzle-kit studio",
		"db:push": "bunx drizzle-kit push",
		"db:pull": "bunx drizzle-kit pull",
		"db:check": "bunx drizzle-kit check",
		"db:up": "bunx drizzle-kit up",
		"db:reset": "bunx drizzle-kit drop && bunx drizzle-kit push"
	},
	"type": "module",
	"author": "Hasiradoo",
	"license": "ISC",
	"dependencies": {
		"@discordjs/rest": "^2.5.1",
		"@discordjs/voice": "^0.18.0",
		"@napi-rs/canvas": "^0.1.77",
		"@supabase/supabase-js": "^2.50.3",
		"@types/get-pixels": "^3.3.4",
		"bunny-log": "^2.1.7",
		"busboy": "^1.6.0",
		"chalk": "^5.4.1",
		"discord-components-v2": "^0.0.4",
		"discord.js": "^14.21.0",
		"dotenv": "^17.0.1",
		"drizzle-orm": "^0.44.2",
		"extract-colors": "^4.2.0",
		"ffmpeg-static": "^5.2.0",
		"fs-extra": "^11.3.0",
		"get-pixels": "^3.3.3",
		"glob": "^11.0.3",
		"js-cookie": "^3.0.5",
		"node-cron": "^4.2.0",
		"node-schedule": "^2.1.1",
		"play-dl": "^1.9.7",
		"postgres": "^3.4.4",
		"prismjs": "^1.30.0",
		"tiny-rabbit-discord": "file:",
		"uuid": "^11.1.0",
		"v2componentsbuilder": "^1.0.27"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.0.6",
		"@types/bun": "^1.2.18",
		"@types/node": "^24.0.10",
		"@types/node-cron": "^3.0.11",
		"@types/node-schedule": "^2.1.7",
		"@types/prismjs": "^1.26.5",
		"drizzle-kit": "^0.31.4",
		"rimraf": "^6.0.1"
	},
	"main": "index.js",
	"keywords": []
}
